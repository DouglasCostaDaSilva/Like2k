# Porta HTTP
PORT=3000

# Endereço público do Zyropay (usado no link de pagamento e no webhook do Mercado Pago)
PUBLIC_URL=https://seu-dominio.com

# Mercado Pago: Suas integrações > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Mercado Pago: Webhooks > Assinatura secreta (valida as notificações)
MP_WEBHOOK_SECRET=

# 1 = provedor simulado (testes locais; nenhum PIX real é gerado)
MOCK_PROVIDER=0

# Taxa padrão do gateway (cada lojista pode ter a sua no admin)
FEE_PERCENT=2
FEE_MIN_CENTS=30

# Login do administrador
ADMIN_USER=ADMIN
ADMIN_PASSWORD=LELEO

# 1 = cookies só por HTTPS (ative em produção)
SECURE_COOKIES=0
