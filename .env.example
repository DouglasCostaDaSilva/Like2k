# Porta HTTP
PORT=3000

# Endereço público do site (https em produção). Usado no webhook do Mercado Pago.
PUBLIC_URL=https://seu-dominio.com

# API que envia os likes (mesmo formato da LikeSystem: /api/likes/send, /api/balance, /api/player/:uid)
LIKE_API_URL=https://likesystem.squareweb.app
LIKE_API_KEY=SUA_API_KEY_AQUI

# Mercado Pago: Suas integrações > seu aplicativo > Credenciais de produção > Access Token
MP_ACCESS_TOKEN=
# Webhooks > Assinatura secreta (valida as notificações). URL do webhook: PUBLIC_URL + /webhooks/mercadopago
MP_WEBHOOK_SECRET=

# 1 = simula a API de likes e o PIX (nenhum like real e nenhum PIX real)
MOCK=0

# Login do painel /admin
ADMIN_USER=ADMIN
ADMIN_PASSWORD=LELEO

# 1 = cookies só por HTTPS (ative em produção)
SECURE_COOKIES=0

# Pasta onde o banco (db.json) é salvo
# DATA_DIR=./data
