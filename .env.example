# Porta HTTP do servidor
PORT=3000

# API que executa os envios (documentação: /api/likes/send, /api/balance, /api/logs, /api/player/:uid)
LIKESYSTEM_API_URL=https://likesystem.squareweb.app
LIKESYSTEM_API_KEY=SUA_API_KEY_AQUI

# 1 = simula a API (para testes locais, nenhum like real é enviado)
MOCK_API=0

# 1 = cookies somente via HTTPS (ative em produção com HTTPS)
SECURE_COOKIES=0

# Senha do login ADMIN (padrão: LELEO)
ADMIN_PASSWORD=LELEO

# Pasta onde o banco (db.json) é salvo
# DATA_DIR=./data
