# ---- Site de acompanhamento (Node) ----
PORT=3000

# Endereço da API de likes (pasta api/, Flask). Em produção, o domínio onde ela roda.
LIKE_API_URL=http://localhost:5001
# Mesma chave configurada na API (API_KEY). Padrão da source: DRIFT
LIKE_API_KEY=DRIFT

# 1 = simula a API (nenhum like real é enviado) para testar o site
MOCK=0

# Login do painel /admin
ADMIN_USER=ADMIN
ADMIN_PASSWORD=LELEO

# 1 = cookies só por HTTPS (ative em produção)
SECURE_COOKIES=0

# Pasta onde o banco (db.json) é salvo
# DATA_DIR=./data
