# Porta HTTP
PORT=3000

# Endereço público do Zyropay (usado no link de pagamento e no webhook do Mercado Pago)
PUBLIC_URL=https://seu-dominio.com

# Aplicativo do Zyropay no Mercado Pago (modelo marketplace): Suas integrações > seu aplicativo
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Redirect URL do aplicativo: PUBLIC_URL + /oauth/mercadopago/callback
# Webhooks > Assinatura secreta (valida as notificações)
MP_WEBHOOK_SECRET=

# Chave para criptografar os tokens dos lojistas em repouso (texto longo e secreto)
ENCRYPTION_KEY=

# 1 = provedor simulado (testes locais; nenhum PIX real é gerado)
MOCK_PROVIDER=0

# Taxa padrão do gateway (cada lojista pode ter a sua no admin)
FEE_PERCENT=2
FEE_MIN_CENTS=30

# Login do administrador
ADMIN_USER=ADMIN
ADMIN_PASSWORD=LELEO

# 1 = cookies só por HTTPS (ative em produção)
SECURE_COOKIES=0
